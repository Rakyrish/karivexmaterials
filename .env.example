# Single shared environment file for KariVex Industrial Materials.
# Both backend/ (Django) and frontend/ (Next.js) read from THIS file — there is
# no separate backend/.env or frontend/.env.local. Copy to .env at the repo
# root for local development. Never commit the real .env file.
#
# In Docker/production, pass this same file to both services via
# `env_file: ../.env` in docker-compose (see deploy/) so both containers get
# an identical, single source of truth.

# =============================================================================
# Shared
# =============================================================================
# Public production origin for the Materials site — used in Django absolute
# URLs/canonicals/structured data AND in the Next.js metadataBase/canonical
# tags. Keep these two in sync; they are intentionally the same value.
SITE_PRODUCTION_ORIGIN=https://materials.karivexsolutionsltd.com
NEXT_PUBLIC_SITE_ORIGIN=https://materials.karivexsolutionsltd.com

# =============================================================================
# Backend (Django)
# =============================================================================
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,materials.karivexsolutionsltd.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# Matches deploy/docker-compose.dev.yml
DATABASE_URL=postgres://karivexmaterials:karivexmaterials_dev_only@localhost:5436/karivexmaterials

# Used for enquiry rate limiting; use redis:// in production with >1 worker
CACHE_URL=locmemcache://

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Local dev: console backend prints enquiry notification emails to the runserver console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: switch to SMTP and fill in real, secret credentials via your host's
# environment/secrets manager — never commit them.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KariVex Industrial Materials <no-reply@materials.karivexsolutionsltd.com>
ENQUIRY_NOTIFICATION_FALLBACK_EMAIL=info@karivexsolutionsltd.com

ENQUIRY_RATE_LIMIT=10/h

# Non-interactive superuser creation (optional, for deploy scripts only; do not commit real values)
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# Server-side only (no NEXT_PUBLIC_ prefix): where the Next.js server fetches
# catalogue/site-settings/enquiry data from. Browser code never calls this
# directly — it goes through Next.js route handlers/server components.
API_BASE_URL=http://localhost:8000

# Analytics is sourced from SiteSettings.ga_measurement_id via the API, not
# duplicated here — leave unset unless you need a build-time override.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
