# KariVex Industrial Materials — environment variables (NO real secrets here).
#
# Local development: copy to `.env` at the repo root. Both backend/ (Django)
# and frontend/ (Next.js) read this one file.
# Production (Docker): copy to `.env.production` at the repo root and fill in
# real values; deploy/docker-compose.prod.yml passes it to both containers.
# Never commit .env or .env.production.

# =============================================================================
# Shared
# =============================================================================
# The single public origin used for canonicals, sitemap, Open Graph, structured
# data and enquiry product links. Keep both values identical.
SITE_PRODUCTION_ORIGIN=https://materials.karivexsolutionsltd.com
NEXT_PUBLIC_SITE_ORIGIN=https://materials.karivexsolutionsltd.com
# Staging only: true adds noindex everywhere. Must be false (or unset) in production.
NEXT_PUBLIC_NOINDEX=false
# Search engine ownership verification (HTML-tag method). Paste only the token
# value from Google Search Console / Bing Webmaster Tools; leave blank otherwise.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Shared secret for Django -> Next.js cache revalidation. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REVALIDATE_SECRET=

# =============================================================================
# Backend (Django)
# =============================================================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Local: True. Production: False.
DJANGO_DEBUG=True
# Production: materials.karivexsolutionsltd.com,backend,127.0.0.1,localhost
# ("backend" is the internal Docker hostname Next.js uses.)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://materials.karivexsolutionsltd.com (needed for admin logins)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# Only for local setups where the browser calls Django on another port.
CORS_ALLOWED_ORIGINS=
# Production behind nginx/Caddy that OVERWRITES X-Forwarded-For: True
TRUST_X_FORWARDED_FOR=False
DJANGO_HSTS_SECONDS=31536000

# Local: Postgres from deploy/docker-compose.dev.yml (or any local Postgres).
# Production: leave unset — compose builds it from the POSTGRES_* values below.
DATABASE_URL=postgres://karivexmaterials:CHANGE_ME@localhost:5436/karivexmaterials
# Production compose database credentials (dedicated to this application).
POSTGRES_DB=karivexmaterials
POSTGRES_USER=karivexmaterials
POSTGRES_PASSWORD=

# Rate-limit store. Local: locmemcache://  Production (3 gunicorn workers):
# dbcache://django_cache  (the table is created automatically on start)
CACHE_URL=locmemcache://
ENQUIRY_RATE_LIMIT=10/h

# --- Email -------------------------------------------------------------------
# Local capture (writes each message to ../.local-mail/, sends nothing):
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# Production (SMTP of the company's mail provider; credentials stay secret):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# The sender must be an address/domain the SMTP provider is authorised to send
# for (SPF/DKIM). Visitor addresses are only ever used as Reply-To.
DEFAULT_FROM_EMAIL=KariVex Industrial Materials <no-reply@materials.karivexsolutionsltd.com>
# Optional: send notifications somewhere other than the Site settings email.
ENQUIRY_NOTIFICATION_EMAIL=

# Next.js -> Django revalidation target. Local: http://localhost:3000/api/revalidate
# Production: set automatically by docker-compose.prod.yml.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Seed missing catalogue records on container start (never overwrites edits).
RUN_SEED=true

# Optional non-interactive superuser creation (deploy scripts only; remove after use):
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# Server-side only: where Next.js fetches catalogue data and posts enquiries.
# Local: http://localhost:8000   Production: set by compose (http://backend:8000)
API_BASE_URL=http://localhost:8000

# Loopback ports the reverse proxy forwards to (production compose).
MATERIALS_WEB_PORT=3410
MATERIALS_API_PORT=8410
